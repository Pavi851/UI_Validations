<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Practice UI Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="UI Validation">
        <classes>
            <class name="tests.SearchValidationTest"/>
            <class name="tests.NavigationValidationTest"/>
            <class name="tests.FilterValidationTest"/>
            <class name="tests.PaginationValidationTest"/>
            <class name="tests.EndToEndValidationTest"/>
        </classes>
    </test>
</suite>
